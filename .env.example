APP_NAME=Misinformation Detection System
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
DEBUG=false
LOG_LEVEL=INFO
MODEL_DIR=models
DATASET_PATH=data/sample_dataset.csv
DATABASE_PATH=data/history.db
FINAL_MODEL_ARTIFACT=models/final/final_pipeline.joblib
FINAL_MODEL_CONFIG=data/reports/model_comparison/final_model_config.json
FINAL_TEST_RESULTS=data/reports/model_comparison/final_test_results.json
MIN_POST_LENGTH=10
MAX_POST_LENGTH=5000
LOW_CONFIDENCE_THRESHOLD=0.6
HIGH_CONFIDENCE_THRESHOLD=0.8
MAX_BATCH_SIZE=50
HISTORY_RESULT_LIMIT=50
MAX_REQUEST_BYTES=1000000
# Future evidence verification is disabled by default and is not used by the current API.
VERIFICATION_ENABLED=false
LIVE_RETRIEVAL_ENABLED=false
EVIDENCE_STORAGE_ENABLED=false
ALLOWED_EVIDENCE_LANGUAGES=hi,en
MAX_EVIDENCE_RESULTS=5
MAX_EVIDENCE_AGE_DAYS=
SEARCH_PROVIDER=
SEARCH_API_KEY=
